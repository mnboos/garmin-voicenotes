<settings>
    <setting propertyKey="@Properties.serverUrl" title="@Strings.ServerLabel"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.serverToken" title="@Strings.TokenLabel"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.serverUrl2" title="@Strings.Server2Label"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.serverToken2" title="@Strings.Token2Label"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.serverUrl3" title="@Strings.Server3Label"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.serverToken3" title="@Strings.Token3Label"><settingConfig type="alphaNumeric"/></setting>
    <setting propertyKey="@Properties.autoUpload" title="@Strings.AutoLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.backgroundPhoneSync" title="@Strings.BackgroundPhoneSyncLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.autoRecord" title="@Strings.AutoRecordLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.vibrateOnRecord" title="@Strings.VibrateLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.vibrateOnStop" title="@Strings.VibrateStopLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.soundOnStart" title="@Strings.SoundStartLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.soundOnStop" title="@Strings.SoundStopLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.autoSave" title="@Strings.AutoSaveLabel"><settingConfig type="boolean"/></setting>
    <setting propertyKey="@Properties.maxSeconds" title="@Strings.MaxLengthLabel">
        <settingConfig type="list">
            <listEntry value="10">@Strings.Len10s</listEntry>
            <listEntry value="30">@Strings.Len30s</listEntry>
            <listEntry value="60">@Strings.Len1m</listEntry>
            <listEntry value="120">@Strings.Len2m</listEntry>
            <listEntry value="300">@Strings.Len5m</listEntry>
            <listEntry value="600">@Strings.Len10m</listEntry>
            <listEntry value="1800">@Strings.Len30m</listEntry>
            <listEntry value="0">@Strings.LenNone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.warnBeforeEnd" title="@Strings.WarnLabel"><settingConfig type="boolean"/></setting>
</settings>
